#!/bin/sh
set -u
ROOT=${1:-}
[ -n "$ROOT" ] || { printf 'Root filesystem path: '; read ROOT; }
[ -d "$ROOT" ] || { echo "Not a directory: $ROOT" >&2; exit 1; }
for d in dev dev/pts proc sys run; do mkdir -p "$ROOT/$d"; done
mountpoint -q "$ROOT/dev" 2>/dev/null || mount --rbind /dev "$ROOT/dev"
mount --make-rslave "$ROOT/dev" 2>/dev/null || true
mountpoint -q "$ROOT/proc" 2>/dev/null || mount -t proc proc "$ROOT/proc"
mountpoint -q "$ROOT/sys" 2>/dev/null || mount --rbind /sys "$ROOT/sys"
mount --make-rslave "$ROOT/sys" 2>/dev/null || true
mountpoint -q "$ROOT/run" 2>/dev/null || mount --bind /run "$ROOT/run"
mountpoint -q "$ROOT/dev/pts" 2>/dev/null || mount -t devpts devpts "$ROOT/dev/pts"
cp -L /etc/resolv.conf "$ROOT/etc/resolv.conf" 2>/dev/null || true
exec chroot "$ROOT" /usr/bin/env -i HOME=/root TERM="${TERM:-xterm-256color}" PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin /bin/sh -l
