ID=recovery
LABEL=Recovery
DESCRIPTION=Diagnostics, filesystem inspection, networking, and archive recovery tools.
INCLUDES=minimal
PACKAGES_COMMON=file less procps util-linux rsync curl wget iproute2 iputils-ping dnsutils strace
PACKAGES_ALPINE=file less procps util-linux rsync curl wget iproute2 iputils bind-tools strace
PACKAGES_ARCH=file less procps-ng util-linux rsync curl wget iproute2 iputils bind strace
PACKAGES_FEDORA=file less procps-ng util-linux rsync curl wget iproute iputils bind-utils strace
PACKAGES_VOID=file less procps-ng util-linux rsync curl wget iproute2 iputils bind-utils strace
